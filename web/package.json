{
  "name": "agentwallet-onboarding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "test:e2e": "playwright test",
    "test:bundle-secrets": "CDP_API_KEY_SECRET=server-secret-sentinel CDP_WALLET_SECRET=wallet-secret-sentinel npm run build && node scripts/assert-no-server-secrets.mjs"
  },
  "dependencies": {
    "@coinbase/cdp-core": "0.0.121",
    "@coinbase/cdp-hooks": "0.0.121",
    "@coinbase/cdp-react": "0.0.121",
    "lucide-react": "^0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "8.2.2"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IntentStatus {
  RECEIVED
  SEARCHING
  QUOTED
  AWAITING_APPROVAL
  APPROVED
  CARD_ISSUED
  CHECKOUT_RUNNING
  DONE
  FAILED
  DENIED
  EXPIRED
}

enum LedgerEntryType {
  RESERVE
  SETTLE
  RETURN
}

enum PotStatus {
  ACTIVE
  SETTLED
  RETURNED
}

enum ApprovalDecisionType {
  APPROVED
  DENIED
}

enum CardCancelPolicy {
  ON_TRANSACTION
  IMMEDIATE
  AFTER_TTL
  MANUAL
}

enum PaymentProvider {
  STRIPE
}

enum PaymentRail {
  CARD
  CRYPTO
}

enum CryptoProtocol {
  X402
}

enum CryptoNetwork {
  BASE_SEPOLIA
}

enum CryptoWalletStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
  CLOSED
}

enum CryptoPermissionStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
  INVALID
}

enum CryptoPaymentStatus {
  AWAITING_APPROVAL
  PREPARED
  EXECUTING
  SUBMITTED
  SUBMISSION_UNKNOWN
  CONFIRMING
  RECONCILING
  SUCCEEDED
  FAILED_PRE_SUBMISSION
  FAILED_ONCHAIN
  DENIED
  EXPIRED
}

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  mainBalance          Int              @default(0)
  maxBudgetPerIntent   Int              @default(50000)
  merchantAllowlist    String[]         @default([])
  mccAllowlist         String[]         @default([])
  paymentProvider      PaymentProvider  @default(STRIPE)
  providerCardholderId String?
  telegramChatId       String?
  phoneNumber          String?
  agentId              String?          @unique
  apiKeyHash           String?
  apiKeyPrefix         String?          @unique
  cancelPolicy         CardCancelPolicy @default(ON_TRANSACTION)
  cardTtlMinutes       Int?
  createdAt            DateTime         @default(now())

  intents              PurchaseIntent[]
  ledgerEntries        LedgerEntry[]
  pots                 Pot[]
  cryptoWalletAccounts CryptoWalletAccount[]
}

model PairingCode {
  id              String   @id @default(cuid())
  code            String   @unique
  agentId         String   @unique
  claimedByUserId String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
}

model PurchaseIntent {
  id             String       @id @default(cuid())
  userId         String
  query          String
  subject        String?
  maxBudget      Int
  currency       String       @default("eur")
  paymentRail    PaymentRail  @default(CARD)
  status         IntentStatus @default(RECEIVED)
  metadata       Json         @default("{}")
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  expiresAt      DateTime?

  user             User              @relation(fields: [userId], references: [id])
  virtualCard      VirtualCard?
  ledgerEntries    LedgerEntry[]
  pot              Pot?
  approvalDecision ApprovalDecision?
  auditEvents      AuditEvent[]
  cryptoPayments   CryptoPayment[]
}

// Addresses are stored lowercase. A BEFORE INSERT/UPDATE trigger canonicalizes
// them, and CHECK constraints reject any other casing — the uniqueness indexes
// below are plain TEXT indexes and would otherwise admit one address twice.
model CryptoWalletAccount {
  id                  String             @id @default(cuid())
  userId              String
  network             CryptoNetwork
  chainId             Int
  customerAddress     String
  customerAccountId   String?            @unique
  executorAddress     String?
  executorAccountId   String?            @unique
  executorAccountName String?            @unique
  status              CryptoWalletStatus @default(PROVISIONING)
  disconnectedAt      DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user             User                    @relation(fields: [userId], references: [id])
  spendPermissions CryptoSpendPermission[]
  cryptoPayments   CryptoPayment[]

  @@unique([userId, network])
  @@unique([network, customerAddress])
  @@unique([network, executorAddress])
  @@index([status])
}

// Addresses and the permission hash are stored lowercase; see
// "CryptoSpendPermission_normalize_addresses" in the migration.
model CryptoSpendPermission {
  id              String                 @id @default(cuid())
  walletAccountId String
  permissionHash  String                 @unique
  network         CryptoNetwork
  chainId         Int
  customerAddress String
  spenderAddress  String
  tokenAddress    String
  assetSymbol     String
  tokenDecimals   Int
  allowanceAtomic Decimal                @db.Decimal(78, 0)
  periodSeconds   Int
  validAfter      DateTime
  validUntil      DateTime
  status          CryptoPermissionStatus @default(PENDING)
  revokedAt       DateTime?
  lastSyncedAt    DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  walletAccount  CryptoWalletAccount @relation(fields: [walletAccountId], references: [id])
  cryptoPayments CryptoPayment[]

  @@index([walletAccountId, status])
  @@index([validUntil])
}

// Invariants Prisma cannot express, all enforced by the migration:
//   - terms are immutable from insert (intent, wallet, permission, protocol,
//     network, amounts, token, recipient, digest, idempotency key) — trigger
//     "CryptoPayment_terms_immutable"
//   - only the reviewed status edges are permitted — trigger
//     "CryptoPayment_status_transition", which must stay in step with
//     TRANSITIONS in src/crypto/paymentStateMachine.ts
//   - at insert, the payment must be scoped to the same customer, wallet,
//     permission, network, chain, token, decimals, and asset symbol, must not
//     exceed the allowance, and both the permission and the wallet must be
//     spendable — trigger "CryptoPayment_scope"
//   - at most one payment per intent outside the four replaceable failure
//     states, so SUCCEEDED permanently closes an intent — partial unique index
//     "CryptoPayment_one_active_per_intent_key"
//   - addresses and hashes are normalized to lowercase on write — trigger
//     "CryptoPayment_normalize_addresses"
//   - CHECK constraints pin address, digest, symbol, decimal, and amount shape
model CryptoPayment {
  id                      String              @id @default(cuid())
  intentId                String
  walletAccountId         String
  spendPermissionId       String
  protocol                CryptoProtocol      @default(X402)
  network                 CryptoNetwork
  chainId                 Int
  displayCurrency         String
  displayAmount           Decimal?            @db.Decimal(36, 18)
  assetSymbol             String
  tokenAddress            String
  tokenDecimals           Int
  amountAtomic            Decimal             @db.Decimal(78, 0)
  recipientAddress        String
  requestDigest           String              @unique
  executionIdempotencyKey String              @unique
  transactionHash         String?             @unique
  userOperationHash       String?             @unique
  status                  CryptoPaymentStatus @default(AWAITING_APPROVAL)
  submittedAt             DateTime?
  confirmedAt             DateTime?
  failedAt                DateTime?
  reconciliationStartedAt DateTime?
  reconciledAt            DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  intent          PurchaseIntent        @relation(fields: [intentId], references: [id])
  walletAccount   CryptoWalletAccount   @relation(fields: [walletAccountId], references: [id])
  spendPermission CryptoSpendPermission @relation(fields: [spendPermissionId], references: [id])

  @@index([intentId])
  @@index([status, updatedAt])
  @@index([spendPermissionId])
}

model VirtualCard {
  id             String          @id @default(cuid())
  intentId       String          @unique
  // Which provider issued this card. Pinned at creation so we never have to
  // infer it later (a user can only switch providers via account-level reset
  // — see #128 — so the user's current paymentProvider is not authoritative
  // for historical cards). No default — every write site must set it
  // explicitly so a future provider can't be silently mis-tagged as STRIPE.
  provider       PaymentProvider
  providerCardId String
  last4          String
  revealedAt     DateTime?
  frozenAt       DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime        @default(now())

  intent PurchaseIntent @relation(fields: [intentId], references: [id])

  // Provider-scoped uniqueness: providerCardId is only unique within a given
  // provider's id-space (Stripe `ic_*` and Privacy `card_*` cannot collide
  // today, but we don't want to depend on that).
  @@unique([provider, providerCardId])
}

model LedgerEntry {
  id        String          @id @default(cuid())
  userId    String
  intentId  String
  type      LedgerEntryType
  amount    Int
  currency  String          @default("eur")
  createdAt DateTime        @default(now())

  user   User           @relation(fields: [userId], references: [id])
  intent PurchaseIntent @relation(fields: [intentId], references: [id])
}

model Pot {
  id             String    @id @default(cuid())
  userId         String
  intentId       String    @unique
  reservedAmount Int
  settledAmount  Int       @default(0)
  status         PotStatus @default(ACTIVE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User           @relation(fields: [userId], references: [id])
  intent PurchaseIntent @relation(fields: [intentId], references: [id])
}

model ApprovalDecision {
  id        String               @id @default(cuid())
  intentId  String               @unique
  decision  ApprovalDecisionType
  actorId   String
  reason    String?
  createdAt DateTime             @default(now())

  intent PurchaseIntent @relation(fields: [intentId], references: [id])
}

model AuditEvent {
  id        String   @id @default(cuid())
  intentId  String?
  actor     String
  agentId   String?
  event     String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  intent PurchaseIntent? @relation(fields: [intentId], references: [id])

  @@index([agentId])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String   @unique
  responseBody Json
  createdAt    DateTime @default(now())
}
